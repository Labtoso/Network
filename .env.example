# ============================================================================
# LABTOSO NETWORK CONTROL CENTER - ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Server
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public Zero-Trust Domain (Cloudflare Tunnel Target)
PUBLIC_DOMAIN=admin.labtoso.de
NEXT_PUBLIC_DOMAIN=admin.labtoso.de

# Zero-Trust Access Policy (Hard-Locked Single Owner Policy)
ALLOWED_EMAIL=sebirauch2022@gmail.com
NEXT_PUBLIC_ALLOWED_EMAIL=sebirauch2022@gmail.com

# Cloudflare Zero Trust Configuration
# Set CF_ZERO_TRUST_STRICT=true to reject requests without Cloudflare headers even on local LAN
CF_ZERO_TRUST_STRICT=false
CF_ACCESS_TEAM_DOMAIN=labtoso.cloudflareaccess.com
CF_ACCESS_AUD=

# Cloudflare Tunnel Token (used by docker-compose cloudflared service)
CLOUDFLARE_TUNNEL_TOKEN=

# Tailscale Mesh VPN (used during LXC installation / status telemetry)
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=network-admin

# Infrastructure Endpoints (for live ping & status telemetry)
PROXMOX_HOST=192.168.178.103
PROXMOX_PORT=8006
ZIMAOS_HOST=192.168.178.67
ADGUARD_URL=http://192.168.178.67:3001
NGINX_URL=http://192.168.178.67:8088
ROUTER_URL=http://192.168.178.1
MSIK_BOT_URL=https://bot.labtoso.de/Msik/
AIO_BOT_URL=https://bot.labtoso.de/AIO/
STREYN_URL=https://musik.labtoso.de
