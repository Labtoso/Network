# ---------------------------------------------------------------------------
# Labtoso Network: Server-Konfiguration (/opt/network/.env)
# Wird von ./manage.sh setup interaktiv erzeugt. Rechte: 600.
# ---------------------------------------------------------------------------

# Backend (lauscht nur lokal, Caddy macht HTTPS davor)
HOST=127.0.0.1
PORT=8787
DATABASE_URL="file:/opt/network/data/network.db"

# DuckDNS: nur die Subdomain, z. B. "labtoso" fuer labtoso.duckdns.org
DUCKDNS_DOMAIN=labtoso
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
DUCKDNS_IPV6=false
# Optionale eigene Domain fuer das BACKEND als CNAME auf <subdomain>.duckdns.org (z. B. api.labtoso.de).
# Nicht admin.labtoso.de: die zeigt auf GitHub Pages (Frontend).
CUSTOM_DOMAIN=
# Oeffentliche Adresse des Backends (Standard: https://<CUSTOM_DOMAIN oder subdomain.duckdns.org>)
PUBLIC_URL=
# E-Mail fuer Let's Encrypt
ACME_EMAIL=

# Google OAuth 2.0 Client-ID (Typ "Webanwendung")
GOOGLE_CLIENT_ID=
# Einzige(r) freigeschaltete(r) Account(s), kommagetrennt
ALLOWED_EMAIL=sebirauch2022@gmail.com
SESSION_HOURS=12

# Zufaellige Geheimnisse (je 64 Hex-Zeichen): openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# Frontends, die die API aufrufen duerfen (GitHub Pages), kommagetrennt
CORS_ORIGINS=https://admin.labtoso.de,https://labtoso.github.io

# AdGuard Home (lokal). Kann spaeter im Panel geaendert werden.
ADGUARD_URL=http://192.168.178.50:80
ADGUARD_USER=
ADGUARD_PASS=

# Roaming: Fallback-Resolver, wenn AdGuard ausfaellt (Offline-Durchsetzung)
FALLBACK_DOH=https://dns.quad9.net/dns-query
DOT_ENABLED=true
DOT_PORT=853

# Statische Dateien fuer die lokale Auslieferung ueber Caddy
STATIC_DIR=/opt/network/out
DUCKDNS_STATUS_FILE=/var/lib/network-admin/duckdns.json

# Tailscale (optional, nur fuer die Installation)
TS_AUTHKEY=
