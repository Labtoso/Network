{
  "name": "network",
  "version": "3.0.0",
  "private": true,
  "description": "Labtoso Network Admin-Panel: AdGuard Home Steuerzentrale mit Google Login, DuckDNS + Caddy, Roaming DoH/DoT und Block-Page-Studio.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:web": "next build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push --skip-generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "dns-packet": "^5.6.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "framer-motion": "^11.18.2",
    "geist": "^1.9.2",
    "google-auth-library": "^9.15.1",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^22.20.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.34",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
