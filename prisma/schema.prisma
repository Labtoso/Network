// Datenbankmodell des Network Admin-Panels (SQLite).
// AdGuard Home bleibt die Quelle der Wahrheit fuer Filter, Regeln, Clients und
// Rewrites. Hier liegt nur, was AdGuard selbst nicht kennt.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Schluessel/Wert-Einstellungen (JSON-codiert). Geheimnisse werden AES-256-GCM verschluesselt abgelegt.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Roaming-Geraet mit eigener AdGuard ClientID fuer DoH/DoT ausserhalb des Heimnetzes.
model RoamingDevice {
  id            String    @id @default(cuid())
  name          String
  clientId      String    @unique
  platform      String
  adguardClient String?
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?
  lastProtocol  String?
  queryCount    Int       @default(0)
  offlineAnswers Int      @default(0)
}

/// Freigabe-Anfrage von der Sperrseite ("Zugang anfordern").
model AccessRequest {
  id         String    @id @default(cuid())
  domain     String
  clientIp   String
  clientName String?
  message    String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  expiresAt  DateTime?
  ruleText   String?

  @@index([status, createdAt])
}

/// Zuletzt bekannte Sperren fuer die Offline-Durchsetzung, wenn AdGuard nicht erreichbar ist.
model BlockCache {
  domain    String   @id
  source    String
  updatedAt DateTime @updatedAt
}

/// Gemessene Latenz der Upstream-DNS-Server und von AdGuard selbst.
model LatencySample {
  id        Int      @id @default(autoincrement())
  target    String
  ms        Int
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}

/// Protokoll aller schreibenden Admin-Aktionen.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
